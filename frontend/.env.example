# Copy to frontend/.env.local and restart Vite.
# Vercel → frontend service → Environment Variables (Production + Preview).

# Safe in the browser — anon key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails allowed to request an admin magic link
VITE_ADMIN_ALLOWED_EMAILS=andrea@powermusic.com

# NEVER add these to the frontend / VITE_* vars:
# - SUPABASE_SERVICE_ROLE_KEY
# - ADMIN_PASSWORD
# - DATABASE_URL

# Optional — defaults to same-origin in production, localhost:8000 in dev
# VITE_API_URL=
